{
  // The servers (Node relay, its JSDoc-typed .mjs), their tests, the PHP tests and the scripts: type-checked by
  // `npm run build` alongside the game (tsconfig.json covers src/).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": ["server", "scripts"]
}
